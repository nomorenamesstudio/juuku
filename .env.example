# Point this at the Navidrome instance whose jukebox you want to drive.
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=change-me
PORT=3101
# Optional shared password; unset means no login (LAN-only default).
# JUUKU_PASSWORD=

# 0.0.0.0 exposes the app (and this API) to the LAN with no auth - only do that
# on a network you trust, e.g. for testing from a phone
HOST=127.0.0.1

# Only when a reverse proxy sits in front: a hop count (`1`) or `loopback`.
# Unset, the client address is the socket's, so the login throttle cannot be
# fooled by a forged X-Forwarded-For.
# JUUKU_TRUST_PROXY=1
