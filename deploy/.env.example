# Navidrome whose jukebox Juuku drives. Use a dedicated, non-admin user: it only
# needs to browse, play and manage its own playlists.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=juuku
NAVIDROME_PASSWORD=change-me

# Only needed when Navidrome itself speaks https with a private CA.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/homelab-ca.pem

TZ=Asia/Bangkok
