# Navidrome whose jukebox Juuku drives. Navidrome only lets an ADMIN drive the
# jukebox by default: either set ND_JUKEBOX_ADMINONLY=false there and keep this a
# plain account (the least privilege that works), or make this account an admin.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=juuku
NAVIDROME_PASSWORD=change-me

# Only needed when Navidrome itself speaks https with a private CA.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/private-ca.pem

# Optional shared password. Unset = no login at all, which is fine on a trusted
# LAN. Set it and the app asks for this once per browser (30-day cookie).
# JUUKU_PASSWORD=

# Only set this when a reverse proxy really is in front: `1` for one hop, or a
# name like `loopback`. Unset, the app believes the socket's own address and a
# forged X-Forwarded-For cannot get around the login throttle.
# JUUKU_TRUST_PROXY=1

TZ=Asia/Bangkok
